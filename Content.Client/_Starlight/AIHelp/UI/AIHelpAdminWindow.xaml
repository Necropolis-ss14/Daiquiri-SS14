<controls:AIHelpAdminWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Starlight.AIHelp.UI"
    Title="{Loc 'ai-help-admin-title'}">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="0 0 0 4">
            <Button Name="RefreshButton" Access="Public" Text="{Loc 'ai-help-admin-refresh'}" />
            <Button Name="CancelButton" Access="Public" Text="{Loc 'ai-help-admin-cancel'}" />
            <Button Name="ClearContextButton" Access="Public" Text="{Loc 'ai-help-admin-clear-context'}" />
            <Button Name="MuteButton" Access="Public" Text="{Loc 'ai-help-admin-mute'}" />
            <Button Name="UnmuteButton" Access="Public" Text="{Loc 'ai-help-admin-unmute'}" />
        </BoxContainer>
        <ItemList Name="RequestList" Access="Public" VerticalExpand="True" MinSize="0 160" />
        <PanelContainer StyleClasses="InsetPanel" VerticalExpand="True" MinSize="0 160">
            <OutputPanel Name="Details" Access="Public" Margin="4" />
        </PanelContainer>
    </BoxContainer>
</controls:AIHelpAdminWindow>
