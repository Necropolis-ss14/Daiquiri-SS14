<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:ui="clr-namespace:Content.Client.Options.UI"
               xmlns:sui="clr-namespace:Content.Client._Starlight.Options.UI"
               Title="{Loc 'ui-glass-prompt-title'}"
               MinSize="720 0">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Name="GlassPage" Access="Public" Orientation="Vertical" Margin="8" SeparationOverride="8" Visible="False">
            <Label Text="{Loc 'ui-glass-prompt-line1'}" />
            <Label Text="{Loc 'ui-glass-prompt-line2'}" />
            <Label Text="{Loc 'ui-glass-prompt-line3'}" />
            <CheckBox Name="GlassCheckBox" Access="Public" Text="{Loc 'ui-options-glass-theme'}" />
            <BoxContainer Name="GlassOptions" Access="Public" Orientation="Vertical" SeparationOverride="8" Visible="False">
                <CheckBox Name="TransparencyCheckBox" Access="Public" Text="{Loc 'ui-options-glass-transparency-enable'}" />
                <ui:OptionSlider Name="TransparencySlider" Access="Public" Title="{Loc 'ui-options-glass-transparency'}" />
                <CheckBox Name="AccentCheckBox" Access="Public" Text="{Loc 'ui-options-glass-accent'}" />
                <ui:OptionColorSlider Name="AccentSlider" Access="Public" Title="{Loc 'ui-options-glass-accent-color'}" />
            </BoxContainer>
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="8">
                <Button Name="BackButton" Access="Public" Text="{Loc 'ui-glass-prompt-back'}" />
                <Button Name="DoneButton" Access="Public" Text="{Loc 'ui-glass-prompt-done'}" />
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Name="ThemePage" Access="Public" Orientation="Vertical" Margin="8" SeparationOverride="8">
            <Label Text="{Loc 'ui-glass-prompt-theme-line'}" />
            <Label Text="{Loc 'ui-glass-prompt-theme-line2'}" />
            <sui:StyleThemePicker Name="ThemePicker" Access="Public" />
            <sui:AccentPicker Name="AccentPicker" Access="Public" />
            <Button Name="NextButton" Access="Public" Text="{Loc 'ui-glass-prompt-next'}"
                    HorizontalAlignment="Right" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
