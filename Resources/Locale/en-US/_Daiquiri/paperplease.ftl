guide-tab-year = [head=3]CURRENT YEAR[/head]{"\u000A"}It is the year 3036.{"\u000A"}Documents issued after 3036 are considered forged.
guide-tab-states = [head=3]STATES AND CAPITALS[/head]{"\u000A"}SSSP - Moscow, Leningrad, Novosibirsk (red){"\u000A"}SolGov - New Washington, New Beijing, New London (blue){"\u000A"}Confederation - Al-Madina, Free Port, Tarsis (purple){"\u000A"}Novo-Nihon - Shiojiri, Hakodate, Kyoto-2 (pink){"\u000A"}Raitoria - Raita, Mercury, Ceres City (dark violet){"\u000A"}Union of Independent Colonies - Colonial Node, Frontier, Wild Port (yellow)
guide-1-convention = [head=3]CONVENTION OF 3031[/head]{"\u000A"}Signatory states recognise each other's passports.{"\u000A"}A valid passport must contain the holder's name, photo, issue city and year, expiry, series and number, issuing authority stamp and holder signature.{"\u000A"}Edition 1: passport only, no NT entry permit required.
guide-1-rules = [head=3]ENTRY RULES - EDITION 1[/head]{"\u000A"}1. Present a signatory passport.{"\u000A"}2. No NT entry permit required.{"\u000A"}3. The passport must not be expired.{"\u000A"}4. The photo must match the holder.
guide-2-convention = [head=3]CONVENTION OF 3031[/head]{"\u000A"}Checks are stricter due to forgery growth.{"\u000A"}A valid passport must contain the holder's name, photo, issue city and year, expiry, series and number, issuing authority stamp and holder signature.{"\u000A"}Edition 2: passport and NT entry permit are both required.
guide-2-rules = [head=3]ENTRY RULES - EDITION 2[/head]{"\u000A"}1. Passport and NT entry permit are required.{"\u000A"}2. Issue city must belong to the passport state.{"\u000A"}3. Expiry cannot be earlier than the issue date.{"\u000A"}4. Document series must match the state.{"\u000A"}5. Stamp and holder signature are required.
guide-3-convention = [head=3]CONVENTION OF 3031[/head]{"\u000A"}Special regime: check every point, deny without explanation.{"\u000A"}A valid passport must contain the holder's name, photo, issue city and year, expiry, series and number, issuing authority stamp and holder signature.{"\u000A"}Edition 3: any mismatch is grounds for denial.
guide-3-rules = [head=3]ENTRY RULES - EDITION 3[/head]{"\u000A"}1. Passport, NT entry permit and photo check are required.{"\u000A"}2. Issue date cannot be later than 3036.{"\u000A"}3. Number must be complete; short numbers are a sign of forgery.{"\u000A"}4. Name mismatch with the holder - denial and detention.{"\u000A"}5. Missing stamp or signature - denial.{"\u000A"}6. Any unresolvable mismatch = denial of entry.
