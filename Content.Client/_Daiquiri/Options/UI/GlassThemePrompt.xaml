<Control xmlns="https://spacestation14.io"
         xmlns:parallax="clr-namespace:Content.Client.Parallax"
         xmlns:sui="clr-namespace:Content.Client._Starlight.Options.UI"
         xmlns:info="clr-namespace:Content.Client.Info"
         VerticalExpand="True" HorizontalExpand="True"
         RectClipContent="True"
         MouseFilter="Stop">
    <parallax:ParallaxControl Name="Space" Access="Public" SpeedX="14" SpeedY="3" />

    <PanelContainer Name="Card" Access="Public" StyleClasses="windowPanel"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
        <BoxContainer Orientation="Horizontal" Margin="18" SeparationOverride="18">
            <TextureRect Name="Art" Access="Public"
                         TexturePath="/Textures/_Daiquiri/Interface/newcomer_art.png"
                         Stretch="KeepAspectCentered"
                         SetSize="240 240"
                         VerticalAlignment="Top" />

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="10">
                <Label Name="TitleLabel" Access="Public" StyleClasses="LabelHeading" />

                <BoxContainer Name="WelcomePage" Access="Public" Orientation="Vertical"
                              HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
                    <RichTextLabel Name="WelcomeLine1" Access="Public" />
                    <RichTextLabel Name="WelcomeLine2" Access="Public" />
                    <Control VerticalExpand="True" />
                    <Button Name="WelcomeNext" Access="Public" Text="{Loc 'ui-newcomer-next'}"
                            HorizontalAlignment="Right" />
                </BoxContainer>

                <BoxContainer Name="RulesPage" Access="Public" Orientation="Vertical"
                              HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8"
                              Visible="False">
                    <RichTextLabel Name="RulesIntro" Access="Public" />
                    <Button Name="ShowRulesButton" Access="Public" Text="{Loc 'ui-newcomer-rules-open'}"
                            HorizontalAlignment="Left" />
                    <info:RulesControl Name="RulesView" Access="Public"
                                       HorizontalExpand="True" VerticalExpand="True" Visible="False" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Button Name="RulesBack" Access="Public" Text="{Loc 'ui-newcomer-back'}" />
                        <Label Name="RulesWaitLabel" VerticalAlignment="Center" HorizontalExpand="True" />
                        <Button Name="RulesAccept" Access="Public" Text="{Loc 'ui-newcomer-rules-accept'}"
                                Disabled="True" />
                    </BoxContainer>
                </BoxContainer>

                <BoxContainer Name="ThemePage" Access="Public" Orientation="Vertical"
                              HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8"
                              Visible="False">
                    <RichTextLabel Name="ThemeLine1" Access="Public" />
                    <RichTextLabel Name="ThemeLine2" Access="Public" />
                    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8"
                                      Margin="0 0 8 0">
                            <sui:StyleThemePicker Name="ThemePicker" Access="Public" Columns="5" />
                            <sui:AccentPicker Name="AccentPicker" Access="Public" />
                            <sui:AccentPicker Name="SecondaryAccentPicker" Access="Public" />
                        </BoxContainer>
                    </ScrollContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Button Name="ThemeBack" Access="Public" Text="{Loc 'ui-newcomer-back'}" />
                        <Control HorizontalExpand="True" />
                        <Button Name="DoneButton" Access="Public" Text="{Loc 'ui-glass-prompt-done'}" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</Control>
