<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maths="clr-namespace:Robust.Shared.Maths;assembly=Robust.Shared.Maths"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:style="clr-namespace:Content.Client.Stylesheets"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:daiquiri="clr-namespace:Content.Client._Daiquiri.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <!-- Background -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" MouseFilter="Stop" />
    <BoxContainer Name="MainContainer" Access="Public" VerticalExpand="True" HorizontalExpand="True" Orientation="Horizontal"
                  Margin="10 10 10 10" SeparationOverride="2">
        <SplitContainer State="Auto" ResizeMode="NotResizable" HorizontalExpand="True">
            <!-- LHS Controls -->
            <BoxContainer Name="LeftSide" Access="Public" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Name="TopLeft" Orientation="Vertical">
                        <!-- Left Top Panel -->
                        <PanelContainer StyleClasses="BackgroundPanel" HorizontalAlignment="Left" Name="LeftSideTop"
                                        VerticalAlignment="Top">
                            <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" MaxWidth="800">
                                <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger" VAlign="Center"
                                       HorizontalExpand="True" HorizontalAlignment="Center" Text="{Loc 'ui-lobby-welcome'}" />
                                <controls:HLine Color="{x:Static style:StyleNano.NanoGold}" Thickness="2" />
                                <info:LinkBanner Name="LinkBanner" VerticalExpand="false" HorizontalAlignment="Center"
                                                 Margin="3 3 3 3" />
                                <controls:StripeBack>
                                    <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="3 3 3 3">
                                        <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                            Text="{Loc 'ui-lobby-observe-button'}"
                                                            StyleClasses="ButtonBig"
                                                            WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                        <Label Name="StartTime"
                                               Access="Public"
                                               Align="Left"
                                               FontColorOverride="{x:Static maths:Color.DarkGray}"
                                               StyleClasses="LabelBig" HorizontalExpand="True" />
                                        <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                                StyleClasses="ButtonBig" MinWidth="137" />
                                    </BoxContainer>
                                </controls:StripeBack>
                                <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" HorizontalAlignment="Center" />
                            </BoxContainer>
                        </PanelContainer>
                        <!-- Voting Popups -->
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0 8" />
                    </BoxContainer>
                    <!-- Vertical Padding-->
                    <Control VerticalExpand="True" />

                    <!-- Left Bot Panel -->
                    <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" MaxWidth="600">
                        <daiquiri:LobbyMusicSwitcher Name="MusicSwitcher" Access="Public" /> <!-- Daiquiri -->
                        <PanelContainer Name="SongPanel" Access="Public" StyleClasses="BackgroundPanel" Margin="3 3 3 3">
                            <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="3 3 3 3">
                                <RichTextLabel Name="LobbySong" Access="Public" HorizontalAlignment="Left" />
                                <RichTextLabel Name="LobbyBackground" Access="Public" HorizontalAlignment="Left" />
                            </BoxContainer>
                        </PanelContainer>
                        <info:DevInfoBanner Name="DevInfoBanner" VerticalExpand="false" Margin="3 3 3 3" />
                        <!-- Daiquiri -->
                        <Button Name="HideUIButton" Access="Public" Text="{Loc 'ui-lobby-hide-ui-button'}"
                                HorizontalAlignment="Left" Margin="3 3 3 3" />
                    </BoxContainer>
                    <!-- NullLink end -->
                </Control>
                <!-- Character setup state -->
                <!-- This is injected on startup. Funky! -->
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>
            <!-- Right Panel -->
            <PanelContainer Name="RightSide" Access="Public" HorizontalAlignment="Right" VerticalExpand="True"
                            VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                    <!-- Top row -->
                    <!--<BoxContainer Orientation="Horizontal" MinSize="0 40" Name="HeaderContainer" Access="Public"
                                   SeparationOverride="4">
                        <Label Margin="8 0 0 0" StyleClasses="LabelHeadingBigger" VAlign="Center"
                               Text="{Loc 'ui-lobby-title'}" />
                        <Label Name="ServerName" Access="Public" StyleClasses="LabelHeadingBigger" VAlign="Center"
                               HorizontalExpand="True" HorizontalAlignment="Center" />
                    </BoxContainer> STARLIGHT-->
                    <!-- Gold line
                    <controls:HLine StyleClasses="highlight" Thickness="2" /> STARLIGHT-->
                    <!-- Daiquiri -->
                    <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right" SeparationOverride="4">
                        <!-- Daiquiri -->
                        <PanelContainer Name="VinylCard" Access="Public" StyleClasses="BackgroundPanel">
                            <TextureButton Name="VinylButton" Access="Public" Margin="6 4"
                                           TexturePath="/Textures/_Daiquiri/Interface/Vinyl/classic_icon.png"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           ToolTip="{Loc 'ui-lobby-vinyl-button-tooltip'}" />
                        </PanelContainer>
                        <PanelContainer Name="ButtonsCard" Access="Public" StyleClasses="BackgroundPanel">
                            <BoxContainer Orientation="Horizontal" MinSize="0 40" HorizontalAlignment="Right" Margin="4">
                                <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}"
                                        StyleClasses="ButtonBig" />
                                <vote:VoteCallMenuButton Name="CallVoteButton" StyleClasses="ButtonBig" />
                                <Button Name="OptionsButton" Access="Public" StyleClasses="ButtonBig"
                                        Text="{Loc 'ui-lobby-options-button'}" />
                                <Button Name="LeaveButton" Access="Public" Text="{Loc 'ui-lobby-leave-button'}" StyleClasses="ButtonBig" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <!-- Daiquiri -->
                    <BoxContainer Name="CharacterRow" Access="Public" Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Stretch" SeparationOverride="4">
                        <!-- Daiquiri -->
                        <PanelContainer Name="ServerInfoCard" Access="Public" StyleClasses="BackgroundPanel"
                                        MinWidth="300" MaxWidth="300">
                            <!-- Daiquiri -->
                            <ScrollContainer HScrollEnabled="False">
                                <BoxContainer Orientation="Vertical" Margin="4">
                                <controls:NanoHeading Text="{Loc 'ui-lobby-server-info-block'}" />
                                <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30" VerticalExpand="false"
                                                 Margin="3 3 3 3" HorizontalAlignment="Left" />
                                <Label Name="StationTime" Access="Public" FontColorOverride="{x:Static maths:Color.LightGray}"
                                       Margin="3 3 3 3" HorizontalAlignment="Left" />
                                </BoxContainer>
                            </ScrollContainer>
                        </PanelContainer>
                        <PanelContainer Name="CharacterCard" Access="Public" StyleClasses="BackgroundPanel"
                                        HorizontalExpand="True" SizeFlagsStretchRatio="1">
                            <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="4">
                                <controls:NanoHeading Text="{Loc 'lobby-character-preview-panel-header'}" />
                                <!-- Daiquiri -->
                                <PanelContainer Name="CharacterTextCard" Access="Public" StyleClasses="BackgroundPanel" HorizontalAlignment="Center">
                                    <BoxContainer Orientation="Vertical" Margin="4" SeparationOverride="2">
                                        <Label Name="CharacterName" Access="Public"
                                               HorizontalAlignment="Center"
                                               FontColorOverride="{x:Static maths:Color.White}" />
                                        <Label Name="CharacterAge" Access="Public"
                                               HorizontalAlignment="Center"
                                               FontColorOverride="{x:Static maths:Color.White}" />
                                    </BoxContainer>
                                </PanelContainer>
                                <profile:ProfilePreviewSpriteView Name="CharacterSprite" Access="Public"
                                    MinSize="160 190" Scale="4 4" HorizontalAlignment="Center" />
                                <Button Name="CharacterSetupButton" Access="Public"
                                         Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                                         HorizontalAlignment="Center" Margin="0 -6 0 0" />
                            </BoxContainer>
                        </PanelContainer>
                    </BoxContainer>
                    <PanelContainer Name="JobsCard" Access="Public" StyleClasses="BackgroundPanel">
                        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" Margin="4" />
                    </PanelContainer>
                    <PanelContainer Name="ChatCard" Access="Public" StyleClasses="BackgroundPanel"
                                    VerticalExpand="True">
                        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="4">
                            <!-- Gold line -->
                            <controls:HLine StyleClasses="highlight" Thickness="2" Access="Public" />
                            <controls:HSpacer Spacing="10" />
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" Margin="3 3 3 3" MinHeight="50" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
                <TextureButton Name="CollapseButton" Access="Public"
                                TexturePath="filled_right_arrow.svg.192dpi"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0 2 2 0"
                                ModulateSelfOverride="#DEDEDE"
                                Scale="0.5 0.5"/>
            </PanelContainer>
        </SplitContainer>
        <PanelContainer Name="ExpandPanel" Access="Public"
                        StyleClasses="BackgroundPanel"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0 2 2 0"
                        Visible="False">
            <TextureButton Name="ExpandButton"
                        TexturePath="filled_left_arrow.svg.192dpi"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ModulateSelfOverride="#DEDEDE"
                        Scale="0.5 0.5"/>
        </PanelContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
