guide-tab-year = [head=3]ТЕКУЩИЙ ГОД[/head]{"\u000A"}Сейчас 3036 год.{"\u000A"}{"\u000A"}Документы, выданные позже 3036 года, считаются поддельными.{"\u000A"}Просроченные паспорта (срок действия истёк до 3036) не принимаются.
guide-tab-states = [head=3]ГОСУДАРСТВА И СТОЛИЦЫ[/head]{"\u000A"}СССП — Москва, Ленинград, Новосибирск (красный){"\u000A"}СолГов — Новый Вашингтон, Новый Пекин, Новый Лондон (синий){"\u000A"}Конфедерация — Аль-Мадина, Свободный порт, Тарсис (фиолетовый){"\u000A"}Ново-нихоновец — Сиодзири, Хакодате, Киото-2 (розовый){"\u000A"}Райтория — Райта, Меркурий, Церера-Сити (тёмно-фиолетовый){"\u000A"}Союз независимых колоний — Колониальный узел, Фронтир, Дикий Порт (жёлтый){"\u000A"}{"\u000A"}Город выдачи обязан принадлежать государству, выдавшему паспорт.
guide-1-convention = [head=3]КОНВЕНЦИЯ 3031 ГОДА[/head]{"\u000A"}Государства-подписанты взаимно признают паспорта.{"\u000A"}Действительный паспорт обязан содержать: имя владельца, фотографию, город и год выдачи, срок действия, серию и номер, печать органа выдачи и роспись владельца.{"\u000A"}Издание 1: достаточно паспорта, разрешение на въезд в НТ не требуется.
guide-1-rules = [head=3]ПРАВИЛА ВЪЕЗДА — ИЗДАНИЕ 1[/head]{"\u000A"}1. Предъявите паспорт государства-подписанта.{"\u000A"}2. Разрешение на въезд в НТ не требуется.{"\u000A"}3. Паспорт не должен быть просрочен.{"\u000A"}4. Фотография должна соответствовать предъявителю.
guide-2-convention = [head=3]КОНВЕНЦИЯ 3031 ГОДА[/head]{"\u000A"}В связи с ростом подделок проверка ужесточается.{"\u000A"}Действительный паспорт обязан содержать: имя владельца, фотографию, город и год выдачи, срок действия, серию и номер, печать органа выдачи и роспись владельца.{"\u000A"}Издание 2: паспорт и разрешение на въезд в НТ обязательны.
guide-2-rules = [head=3]ПРАВИЛА ВЪЕЗДА — ИЗДАНИЕ 2[/head]{"\u000A"}1. Паспорт и разрешение на въезд в НТ обязательны.{"\u000A"}2. Город выдачи обязан принадлежать государству паспорта.{"\u000A"}3. Срок действия не может быть меньше даты выдачи.{"\u000A"}4. Серия документа должна соответствовать государству.{"\u000A"}5. Печать органа выдачи и роспись владельца обязательны.
guide-3-convention = [head=3]КОНВЕНЦИЯ 3031 ГОДА[/head]{"\u000A"}Особый режим: проверка по каждому пункту, отказ без объяснений.{"\u000A"}Действительный паспорт обязан содержать: имя владельца, фотографию, город и год выдачи, срок действия, серию и номер, печать органа выдачи и роспись владельца.{"\u000A"}Издание 3: любая нестыковка — отказ во въезде.
guide-3-rules = [head=3]ПРАВИЛА ВЪЕЗДА — ИЗДАНИЕ 3[/head]{"\u000A"}1. Паспорт, разрешение на въезд и сверка фотографии обязательны.{"\u000A"}2. Дата выдачи не может быть позже 3036 года.{"\u000A"}3. Номер должен быть полным; сокращённые номера — признак подделки.{"\u000A"}4. Несовпадение ФИО с предъявителем — отказ и задержание.{"\u000A"}5. Отсутствие печати или росписи — отказ.{"\u000A"}6. Любая неустранимая нестыковка = отказ во въезде.{"\u000A"}7. При сопротивлении, попытке бегства или подозрении на подделку проверяющий вправе казнить нарушителя на месте.
