<DefaultWindow xmlns="https://spacestation14.io"
                Title="{Loc 'ui-lobby-music-queue-title'}"
                MinSize="600 300">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="6">
        <PanelContainer StyleClasses="BackgroundPanel" VerticalExpand="True"
                       MinWidth="190" MaxWidth="230" Margin="4">
            <ScrollContainer VerticalExpand="True">
                <BoxContainer Name="PlaylistList" Access="Public" Orientation="Vertical" VerticalExpand="True"
                              HorizontalExpand="True" SeparationOverride="2" />
            </ScrollContainer>
        </PanelContainer>
        <PanelContainer StyleClasses="BackgroundPanel" ModulateSelfOverride="#c9a227" VerticalExpand="True"
                        MinWidth="2" MaxWidth="2" Margin="0 8 0 8" />
        <PanelContainer Name="TrackPanel" Access="Public" StyleClasses="BackgroundPanel"
                        HorizontalExpand="True" VerticalExpand="True" Margin="4">
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Name="TrackList" Access="Public" Orientation="Vertical" VerticalExpand="True"
                              HorizontalExpand="True" SeparationOverride="2" />
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</DefaultWindow>
