cmd-nightshift-desc = Переопределяет ночное освещение на каждой станции или на одной станции.
cmd-nightshift-help = Использование: nightshift <Auto|Day|Night> [станция]
    Auto следует времени и событиям станции, Day и Night принудительно задают освещение до возврата к Auto.
cmd-nightshift-hint-mode = <Auto|Day|Night>
cmd-nightshift-hint-station = [станция]
cmd-nightshift-invalid-mode = "{ $mode }" — не режим освещения, используйте Auto, Day или Night.
cmd-nightshift-invalid-station = "{ $station }" — не станция.
cmd-nightshift-success-all = Ночная смена всех станций установлена в { $mode }.
cmd-nightshift-success = Ночная смена { $station } установлена в { $mode }.
