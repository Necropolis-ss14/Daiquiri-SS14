<BoxContainer xmlns="https://spacestation14.io"
              xmlns:lobbyUi="clr-namespace:Content.Client._Daiquiri.Lobby.UI"
              Orientation="Vertical"
              SeparationOverride="0">
    <TextureRect Name="VinylRect" Access="Public" HorizontalAlignment="Left" MinSize="192 192"
                 Stretch="Scale" MouseFilter="Stop"
                 TexturePath="/Textures/_Daiquiri/Interface/Vinyl/classic_2.png" />
    <PanelContainer StyleClasses="BackgroundPanel">
        <BoxContainer Orientation="Horizontal" SeparationOverride="4" Margin="4">
            <Button Name="PrevButton" Access="Public" Text="◀" MinWidth="32" />
            <lobbyUi:MarqueeLabel Name="TrackLabel" Access="Public" HorizontalExpand="True"
                                  VerticalAlignment="Center" ClipText="True" />
            <Button Name="QueueButton" Access="Public" Text="☰" MinWidth="32"
                    ToolTip="{Loc 'ui-lobby-music-queue-tooltip'}" />
            <Button Name="NextButton" Access="Public" Text="▶" MinWidth="32" />
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
